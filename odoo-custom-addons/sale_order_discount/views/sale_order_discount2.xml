<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="sale_order_discount_tree" model="ir.ui.view">
        <field name="name">sale.order.discount.tree.view</field>
        <field name="model">sale.order.discount</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="sale_order_type" />
                <field name="discount" />
                <field name="monto" />
                <field name="product_id" />
                <field name="active" />
                <field name="dia" widget="many2many_tags" />
                <field name="company_id" />
            </tree>
        </field>
    </record>
</odoo>
