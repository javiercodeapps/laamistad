<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="sale_order_discount_tree" model="ir.ui.view">
        <field name="name">sale.order.discount.tree.view</field>
        <field name="model">sale.order.discount</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="sale_order_type" />
                <field name="discount" />
                <field name="monto" />
                <field name="product_id" />
                <field name="active" />
                <field name="dia" widget="many2many_tags" />
                <field name="company_id" />
            </tree>
        </field>
    </record>
    <record id="sale_order_discount_form" model="ir.ui.view">
        <field name="name">sale.order.discount.form.view</field>
        <field name="model">sale.order.discount</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name" />
                    <field name="sale_order_type" />
                    <field name="discount" />
                    <field name="monto" />
                    <field name="product_id" />
                    <field name="dia" widget="many2many_tags" />
                    <field name="active" />
                    <field name="company_id" />
                </group>
            </form>
        </field>
    </record>
    <record id="sale_order_discount_menu" model="ir.actions.act_window">
        <field name="name">Descuentos</field>
        <field name="res_model">sale.order.discount</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_sale_order_discount" name="Descuentos"
        parent="sale.menu_sales_config"
        action="sale_order_discount_menu" />
</odoo>
