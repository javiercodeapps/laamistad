<odoo>
    <record id="view_cerrar_sesion_form" model="ir.ui.view">
        <field name="name">cerrar.sesion.wizard.form</field>
        <field name="model">cerrar.sesion.wizard</field>
        <field name="arch" type="xml">
            <form string="Cerrar Sesión de Caja">
                <group>
                    <field name="efectivo_fin"/>
                </group>
                <footer>
                    <button string="Cerrar Sesión" type="object" name="cerrar_sesion" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>