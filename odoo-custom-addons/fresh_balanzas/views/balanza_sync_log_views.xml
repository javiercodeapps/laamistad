<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_balanza_sync_log_tree" model="ir.ui.view">
        <field name="name">balanza.sync.log.tree</field>
        <field name="model">balanza.sync.log</field>
        <field name="arch" type="xml">
            <tree>
                <field name="create_date" string="Fecha"/>
                <field name="scale_id"/>
                <field name="sync_type"/>
                <field name="product_count"/>
                <field name="success_count"/>
                <field name="error_count"/>
                <field name="state"/>
                <field name="user_id"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_balanza_sync_log_form" model="ir.ui.view">
        <field name="name">balanza.sync.log.form</field>
        <field name="model">balanza.sync.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="scale_id"/>
                            <field name="sync_type"/>
                            <field name="state"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="start_time"/>
                            <field name="end_time"/>
                            <field name="product_count"/>
                            <field name="success_count"/>
                            <field name="error_count"/>
                        </group>
                    </group>
                    <field name="log" readonly="1" nolabel="1"
                           placeholder="Detalle de la sincronización"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_balanza_sync_log" model="ir.actions.act_window">
        <field name="name">Logs de Sincronización</field>
        <field name="res_model">balanza.sync.log</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
