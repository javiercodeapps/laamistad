<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Botón en el formulario de producto -->
    <record id="product_template_form_view_balanzas" model="ir.ui.view">
        <field name="name">product.template.form.balanzas</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_to_scales" type="object"
                        string="Actualizar en balanzas" icon="fa-balance-scale"/>
            </xpath>
        </field>
    </record>

    <!-- Botón en el listado de productos (usa los seleccionados) -->
    <record id="product_template_tree_view_balanzas" model="ir.ui.view">
        <field name="name">product.template.tree.balanzas</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_to_scales" type="object"
                        string="Actualizar en balanzas" icon="fa-balance-scale"/>
            </xpath>
        </field>
    </record>

    <!-- Botón en el listado de variantes -->
    <record id="product_product_tree_view_balanzas" model="ir.ui.view">
        <field name="name">product.product.tree.balanzas</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_to_scales" type="object"
                        string="Actualizar en balanzas" icon="fa-balance-scale"/>
            </xpath>
        </field>
    </record>
</odoo>
