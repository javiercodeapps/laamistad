<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_sale_order_with_invoice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="order">
                <div class="page">
                    <h2>Sale Order: <t t-esc="order.name"/></h2>
                    <p>Customer: <t t-esc="order.partner_id.name"/></p>
                    <p>Order Date: <t t-esc="order.date_order"/></p>
                    
                    <h3>Related Invoices</h3>
                    <table class="table table-condensed">
                        <thead>
                            <tr>
                                <th>Invoice #</th>
                                <th>Date</th>
                                <th>Total</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="order.get_related_invoices()" t-as="invoice">
                                <tr>
                                    <td><t t-esc="invoice.name"/></td>
                                    <td><t t-esc="invoice.invoice_date"/></td>
                                    <td><t t-esc="invoice.amount_total"/></td>
                                    <td><t t-esc="invoice.state"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
