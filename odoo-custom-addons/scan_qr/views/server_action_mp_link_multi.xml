<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_server_create_mp_link_multi" model="ir.actions.server">
        <field name="name">Generar Link de Pago MP</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">
            action = env['ir.actions.act_window']._for_xml_id('scan_qr.action_mp_link_multi_wizard')
            action['context'] = {'default_order_ids': env.context.get('active_ids', [])}
            return action
        </field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
    </record>
</odoo>
