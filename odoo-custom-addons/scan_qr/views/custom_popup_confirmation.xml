<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="custom_popup_confirmation" model="ir.ui.view">
        <field name="name">Custom Popoup Confirmation</field>
        <field name="model">paimon.popup.confirmation</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Confirmation" version="15.0">
                <separator string="Confirmation" colspan="6"/>
                <field name="message" colspan="4" nolabel="1" readonly="1"  widget="html"/>                                                            
                <newline/>
                <separator colspan="6"/>
                <footer>
	    	    <button name="confirm" type="object" string="MP Link" context="{'payment_type': 'MP Link'}" class="oe_highlight btn-primary px-4 py-4"/>
	    	    <button name="confirm" type="object" string="MP QR" context="{'payment_type': 'MP QR'}" class="oe_highlight btn-primary px-4 py-4"/>
	    	    <button name="confirm" type="object" string="MP Point" context="{'payment_type': 'MP Point'}" class="oe_highlight btn-primary px-4 py-4"/>
	    	    <button name="confirm" type="object" string="MP Transferencia" context="{'payment_type': 'MP Transferencia'}" class="oe_highlight btn-primary px-4 py-4"/>
                    <button special="cancel" string="No" class="btn btn-primary px-4 py-4"/>                    
                </footer>                                    
            </form>
        </field>
    </record>      
    <record id="custom_popup_efectivo" model="ir.ui.view">
        <field name="name">Custom Popoup Efectivo</field>
        <field name="model">paimon.popup.confirmation</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Confirmation" version="15.0">
                <separator string="Confirmation" colspan="6"/>
                <field name="message" colspan="4" nolabel="1" readonly="1"  widget="html"/>                                                            
                <newline/>
                <separator colspan="6"/>
		<h2>
                    <field name="text" widget="float" nolabel="1" />                                                            
	        </h2>
                <footer>
                    <button name="confirm" type="object" string="OTROS"  context="{'payment_type': 'OTROS'}" class="btn btn-primary px-4 py-4"/>
	    	    <button name="confirm" type="object" string="MP Link" context="{'payment_type': 'MP Link'}" class="oe_highlight btn-primary px-4 py-4"/>
	    	    <button name="confirm" type="object" string="MP QR" context="{'payment_type': 'MP QR'}" class="oe_highlight btn-primary px-4 py-4"/>
	    	    <button name="confirm" type="object" string="MP Point" context="{'payment_type': 'MP Point'}" class="oe_highlight btn-primary px-4 py-4"/>
	    	    <button name="confirm" type="object" string="MP Transferencia" context="{'payment_type': 'MP Transferencia'}" class="oe_highlight btn-primary px-4 py-4"/>
                    <button special="cancel" string="No" class="btn btn-primary px-4 py-4"/>                    
                </footer>                                    
            </form>
        </field>
    </record>      
    <record id="custom_popup_clave" model="ir.ui.view">
        <field name="name">Custom Popoup clave</field>
        <field name="model">paimon.popup.confirmation</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Autorizacion" version="15.0">
                <separator string="Autorizacion" colspan="6"/>
                <field name="message" colspan="4" nolabel="1" readonly="1"  widget="html"/>                                                            
		<h2>
                    <field name="text" colspan="4" nolabel="1" />                                                            
	        </h2>
                <newline/>
                <separator colspan="6"/>
                <footer>
	    	    <button name="confirm" type="object" string="Autorizar" class="oe_highlight btn-primary px-4 py-4"/>
                    <button special="cancel" string="No" class="btn btn-primary px-4 py-4"/>                    
                </footer>                                    
            </form>
        </field>
    </record>      
</odoo>
