<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_bl_afip_status_recovery" model="ir.cron">
        <field name="name">BlackLabs - ARCA: verificar recuperacion del servicio</field>
        <field name="model_id" ref="model_bl_afip_status"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_recovery()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <!-- En 16 el default es 1: el cron se desactivaria tras la primera
             corrida. El modulo lo activa/desactiva dinamicamente, asi que
             debe correr ilimitado. -->
        <field name="numbercall" eval="-1"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="priority">10</field>
        <field name="active" eval="False"/>
    </record>
</odoo>
