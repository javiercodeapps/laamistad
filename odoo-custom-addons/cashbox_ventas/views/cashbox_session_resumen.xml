<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_cashbox_resumen" model="ir.actions.act_window">
         <field name="name">Resumen de Caja</field>
         <field name="type">ir.actions.act_window</field>
         <field name="res_model">account.cashbox.resumen</field>  
         <field name="view_mode">tree,form</field>
         <field name="context">{}</field>
    </record>
    <record id="action_cashbox_resumen_config" model="ir.actions.act_window">
         <field name="name">Resumen de Caja Config</field>
         <field name="type">ir.actions.act_window</field>
         <field name="res_model">account.cashbox.resumen.config</field>  
         <field name="view_mode">tree,form</field>
         <field name="context">{}</field>
    </record>
    <record id="tree_cashbox_resumen_config_tree" model="ir.ui.view">
        <field name="name">account_cashbox.resumen.config.tree</field>
        <field name="model">account.cashbox.resumen.config</field>
        <field name="arch" type="xml">
	    <tree>
		<field name='type_pay_id'/>
		<field name='type_id'/>
		<field name='tipo_resumen'/>
		<field name='valor'/>
	    </tree>
	</field>
    </record>

    <record id="tree_cashbox_resumen" model="ir.ui.view">
        <field name="name">account_cashbox.resumen.tree</field>
        <field name="model">account.cashbox.resumen</field>
        <field name="arch" type="xml">
	    <tree>
		<field name='name'/>
		<field name='opening_date'/>
		<field name='closing_date'/>
		<field name='company_id'/>
	    </tree>
	</field>
    </record>

    <record id="view_cashbox_resumen" model="ir.ui.view">
        <field name="name">account_cashbox.resumen</field>
        <field name="model">account.cashbox.resumen</field>
        <field name="arch" type="xml">
	<form>
	    <header>
	            <button name="compute_sale_ids" type="object" string="Procesar" class="oe_highlight -primary"/>
	    </header>
	    <h1 class="oe_title">
	        <field name="name"  class="oe_inline"/>
            </h1>
            <group>
                <group>
                    <field name="company_id"/>
			<!--          <field name="cashbox_ids" widget="many2many_tags"/> -->
	        </group>
                <group>
                    <field name="opening_date"/>
                    <field name="closing_date"/>
                    <field name="opening_compra"/>
                    <field name="closing_compra"/>
                </group>
	        <newline/>
                <field name="resumen_ids" invisible="True"/>
            </group>
	    <notebook>
	    <page string='Resumen'>
		<h2>
		        <field nolabel="1" name="totales_ids">
	   	            <tree create="false" delete="false">
   		                <field name="type_id" options="{'bg_color': 'pink: count == 2;cyan: count == 1'}"/>
		                <field name="count" invisible="True"/>
		                <field name="amount" options="{'bg_color': 'pink: count == 2;cyan: count == 1'}" widget="integer" />
		            </tree>
		        </field>
	        </h2>
	    </page>
	    <page string='Ventas'>
		        <field nolabel="1" name="ventas_ids">
	   	            <tree create="false" delete="false">
		                <field name="type_pay_id" />
		                <field name="type_id" />
		                <field name="count" />
		                <field name="amount" sum="Total" widget="integer" />
		            </tree>
		        </field>
            </page>
	    <page string='Gastos Generales'>
		        <field nolabel="1" name="gastos_ids">
	   	            <tree create="false" delete="false">
		                <field name="type_pay_id" />
		                <field name="type_id" />
		                <field name="count" />
		                <field name="amount" sum="Total" widget="integer" />
		            </tree>
		        </field>
            </page>
	    <page string='Sueldos'>
		        <field nolabel="1" name="sueldos_ids">
	   	            <tree create="false" delete="false">
		                <field name="type_pay_id" />
		                <field name="type_id" />
		                <field name="count" />
		                <field name="amount" sum="Total" widget="integer" />
		            </tree>
		        </field>
            </page>
	    <page string='Detalle'>
		        <field nolabel="1" name="resumen_ids">
	   	            <tree create="false" delete="false">
		                <field name="type_pay_id" />
		                <field name="type_id" />
		                <field name="count" />
		                <field name="amount" sum="Total" widget="integer" />
		            </tree>
		        </field>
            </page>
	    <page string='Log'>
		<group>
			<field nolabel="1" name="logs"/>
		</group>
            </page>
	    </notebook>
	</form>
	
	</field>
    </record>
</odoo>
