<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_cashbox">
        <t t-call="web.external_layout">
            <div class="page">
                <div class="oe_structure" />
                <div class="row">
                    <div class="col-xs-6">
                        <div t-field="doc.name" />
                        <p>Caja:<span t-field="doc.cashbox_id.name" /></p>
                    </div>
                </div>
                <h3>
                    <span>Fecha de apertura </span>
                    <span t-field="doc.opening_date" />
                    <span>Fecha de cierre </span>
                    <span t-field="doc.closing_date" />
                </h3>
                <table class="table table-condensed">
                    <thead>
                        <tr>
                            <th>Caja</th>
                            <th class="text-right">Saldo Incial</th>
                            <th class="text-center">Movimientos</th>
                            <th class="text-right">Saldo Final</th>
                            <th class="text-right">Saldo Final Real</th>
                        </tr>
                    </thead>
                    <tbody class="purchase_tbody">
                        <t t-foreach="doc.line_ids" t-as="l">
                            <tr>
                                <td name="td_name" class="text-left">
                                    <span t-field="l.journal_id.name" />
                                </td>
                                <td class="text-right">
                                    <span t-field="l.balance_start" />
                                </td>
                                <td class="text-center">
                                    <span t-field="l.amount" />
                                </td>
                                <td class="text-right">
                                    <span t-field="l.balance_end" />
                                </td>
                                <td class="text-right">
                                    <span
                                        t-field="l.balance_end_real"
                                    />
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </t>
    </template>
    <template id="report_cashbox">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t
                    t-call="account.cashbox.report_cashbox"
                    t-lang="doc.partner_id.lang"
                />
            </t>
        </t>
    </template>
</odoo>
